# Secrets
.env

# Your targeting rules: rate floor, employer blocklist, resume path.
# Never commit this. profile.example.yaml is the committed template.
profile.yaml

# Everything local: the resume, the CV builder, the SQLite store, digests.
# Nothing under data/ belongs in a public repo.
data/
!data/.gitkeep

# Boards that exist only on this machine, and their tests. main.py loads
# anything here that satisfies the Source protocol (sources/discovery.py); a
# clean clone has neither directory and runs the three committed sources only.
sources/local/
tests/local/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Wrangler local state and the dashboard's installed deps. Both are rebuildable
# and neither belongs in the repo.
.wrangler/
dashboard/node_modules/
